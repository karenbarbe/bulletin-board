<nav aria-label="breadcrumb">
  <ul>
    <li>Home</li>
  </ul>
</nav>


<% list_of_boards = Board.all %>

<article>
  <header>
    All boards
  </header>
  <ul>
    <% list_of_boards.each do |board| %>
    <li>
      <a href="/boards/<%= board.id %>">

      <%= board.name %>
      </a>
    </li>
    <% end %>
  </ul>
</article>
