<% the_id = params.fetch("path_id") %>
<% the_board = Board.where({ :id => the_id }).first %>

<h1><%= the_board.name %></h1>

<% all_listings = Listing.where({ :board_id => the_id }) %>
<% active_listings = all_listings.where({ :expires_on => (Date.today...) }) %>
<% expired_listings = all_listings.where({ :expires_on => (...Date.today) }) %>


<article>
<header>
  Active listings
</header>
  <table>
    <thead>
      <th>Title</th>
      <th>Body</th>
      <th>Expires on</th>
      <th>Posted on</th>
    </thead>
<% active_listings.each do |listing| %>
  <tr>
    <td><%= listing.title %></td>
    <td><%= listing.body %></td>
    <td><%= listing.expires_on.strftime("%b %e, %Y") %></td>
    <td><%= listing.created_at.strftime("%b %e, %Y") %></td>
  </tr>
<% end %>

  </table>
</article>



<h2>Expired listings</h2>

<ul>
  <% expired_listings.each do |listing| %>
    <li>
      <%= listing.title %> (<%= listing.expires_on %>)
    </li>
  <% end %>
</ul>
